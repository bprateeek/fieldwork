{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldwork.local/schema/pr-request.schema.json",
  "title": "Fieldwork PR Request Protocol v2",
  "description": "Broker metadata transported with a raw non-thin Git pack. The broker never reads the submitting checkout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "created_at",
    "slug",
    "branch",
    "title",
    "body",
    "head_oid",
    "common_base_oid"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,30}$"
    },
    "branch": {
      "type": "string",
      "pattern": "^fieldwork/[a-z0-9][a-z0-9/_-]{1,80}$"
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[^\\r\\n]*$"
    },
    "body": {
      "type": "string",
      "maxLength": 65536
    },
    "head_oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "common_base_oid": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        {"type": "null"}
      ]
    }
  }
}
