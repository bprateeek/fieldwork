#!/usr/bin/env bash
set -euo pipefail
uid="$(id -u fieldwork-agent)"
group="$(id -gn fieldwork-agent)"
case "$(uname -s)" in
  Darwin)
    install -d -o root -g wheel -m 0755 /private/var/run/fieldwork
    install -d -o fieldwork-agent -g "$group" -m 0700 "/private/var/run/fieldwork/$uid"
    ;;
  Linux)
    install -d -o fieldwork-agent -g "$group" -m 0700 "/run/user/$uid"
    ;;
  *) exit 1 ;;
esac
