#!/usr/bin/python3 -I
"""Run and record the per-Claude-digest local hard-boundary probe."""
import hashlib
import json
import os
from pathlib import Path
import pwd
import re
import stat
import subprocess
import sys


def parse_events(output: bytes) -> tuple[list[dict[str, object]], list[dict[str, object]]]:
    events = []
    items = []
    for raw in output.splitlines():
        try:
            event = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if not isinstance(event, dict):
            continue
        events.append(event)
        message = event.get("message")
        content = message.get("content", []) if isinstance(message, dict) else []
        if isinstance(content, list):
            items.extend(item for item in content if isinstance(item, dict))
    return events, items


def tool_command(item: dict[str, object]) -> str:
    tool_input = item.get("input")
    if not isinstance(tool_input, dict):
        return ""
    return str(tool_input.get("command", ""))


def result_text(value: object) -> str:
    if isinstance(value, str):
        return value
    if value is None:
        return ""
    return json.dumps(value, sort_keys=True, separators=(",", ":"))


def analyze_attempt(output: bytes, expected_command: str) -> tuple[str, str]:
    """Return the paired result text or a stable, non-sensitive failure label."""
    events, items = parse_events(output)
    tool_uses = [item for item in items if item.get("type") == "tool_use"]
    if len(tool_uses) != 1:
        return "", f"tool-use-count-{len(tool_uses)}"
    use = tool_uses[0]
    if use.get("name") != "Bash" or tool_command(use) != expected_command:
        return "", "unexpected-tool-use"
    ident = use.get("id")
    if not isinstance(ident, str) or not ident:
        return "", "missing-tool-use-id"

    payloads = []
    paired = False
    for event in events:
        message = event.get("message")
        content = message.get("content", []) if isinstance(message, dict) else []
        if not isinstance(content, list):
            continue
        matching = [
            item for item in content
            if isinstance(item, dict)
            and item.get("type") == "tool_result"
            and item.get("tool_use_id") == ident
        ]
        if not matching:
            continue
        paired = True
        payloads.extend(item.get("content", "") for item in matching)
        if "tool_use_result" in event:
            payloads.append(event["tool_use_result"])
    if not paired:
        return "", "missing-tool-result"
    return "\n".join(result_text(value) for value in payloads), ""


if os.getuid() != 0:
    print("fieldwork-local probe must run as root", file=sys.stderr)
    raise SystemExit(1)
args = sys.argv[1:]
oauth_token = None
if len(args) == 3 and args[0] == "--ci-oauth-token-file":
    if sys.platform != "linux":
        print("CI OAuth token files are supported only by the Linux acceptance runner", file=sys.stderr)
        raise SystemExit(1)
    token_path = Path(args[1])
    if not token_path.is_absolute():
        print("CI OAuth token file must be an absolute path", file=sys.stderr)
        raise SystemExit(1)
    try:
        token_info = token_path.lstat()
        token_data = token_path.read_bytes()
    except OSError:
        print("CI OAuth token file is missing or unsafe", file=sys.stderr)
        raise SystemExit(1)
    if (
        not stat.S_ISREG(token_info.st_mode)
        or token_info.st_uid != 0
        or stat.S_IMODE(token_info.st_mode) != 0o600
    ):
        print("CI OAuth token file must be a root-owned mode 0600 regular file", file=sys.stderr)
        raise SystemExit(1)
    if not 20 <= len(token_data) <= 8192 or any(byte <= 0x20 or byte > 0x7E for byte in token_data):
        print("CI OAuth token file must contain one non-whitespace token", file=sys.stderr)
        raise SystemExit(1)
    oauth_token = token_data.decode("ascii")
    args = args[2:]
if len(args) != 1 or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,30}", args[0]):
    print("usage: fieldwork-local probe [--ci-oauth-token-file <absolute-file>] <slug>", file=sys.stderr)
    raise SystemExit(2)
slug = args[0]
root = Path("/usr/local/lib/fieldwork-local")
claude = root / "claude-pinned"
managed_settings = (
    Path("/Library/Application Support/ClaudeCode/managed-settings.json")
    if sys.platform == "darwin"
    else Path("/etc/claude-code/managed-settings.json")
)
managed_roots = (root, Path("/usr/local/share/fieldwork-claude"))
managed_entries = tuple(path for base in managed_roots for path in base.rglob("*"))
if any(path.is_symlink() for path in managed_entries):
    print("hard-boundary inventory contains a symlink", file=sys.stderr)
    raise SystemExit(1)
assets = (
    Path("/usr/local/sbin/fieldwork-local"),
    Path("/usr/local/bin/fieldwork-pr-build"),
    Path("/usr/local/bin/fieldwork-pr-upload"),
    Path("/usr/local/bin/fieldwork-bash-policy"),
    Path("/usr/local/etc/fieldwork-agent.uid"),
    managed_settings,
    claude,
    root / "claude.sha256",
    root / "empty-mcp.json",
    root / "strict-managed-settings.json",
    root / "fieldwork-policy-helper",
    root / "fieldwork-local-claude",
    root / "fieldwork-local-probe",
    root / "spool-init",
    root / "docker-compose.yml",
    root / "entrypoint.sh",
    root / "context/lib/local/Dockerfile",
    root / "context/lib/broker/server.py",
    root / "context/lib/broker/originnorm.py",
    root / "context/lib/broker/policy_writer.py",
    root / "context/schema/pr-request.schema.json",
) + tuple(path for path in managed_entries if path.is_file())
for asset in assets:
    try:
        info = asset.lstat()
    except OSError as exc:
        print(f"hard-boundary asset is unavailable: {asset}: {exc}", file=sys.stderr)
        raise SystemExit(1)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        print(f"hard-boundary asset is not a root-owned, non-writable regular file: {asset}", file=sys.stderr)
        raise SystemExit(1)
expected = (root / "claude.sha256").read_text().strip()
actual = hashlib.sha256(claude.read_bytes()).hexdigest()
if actual != expected:
    print("pinned Claude digest changed before probe", file=sys.stderr)
    raise SystemExit(1)
policy = json.loads((root / "strict-managed-settings.json").read_text())
if not (
    policy.get("sandbox", {}).get("failIfUnavailable") is True
    and policy.get("sandbox", {}).get("allowUnsandboxedCommands") is False
    and policy.get("sandbox", {}).get("network", {}).get("allowedDomains") == []
    and policy.get("sandbox", {}).get("network", {}).get("allowManagedDomainsOnly") is True
    and policy.get("allowManagedPermissionRulesOnly") is True
    and policy.get("allowManagedMcpServersOnly") is True
    and policy.get("permissions", {}).get("allow") == [
        "Bash", "Edit", "Read", "Write", "Glob", "Grep",
    ]
    and policy.get("permissions", {}).get("disableBypassPermissionsMode") == "disable"
):
    print("managed hard-boundary policy is incomplete", file=sys.stderr)
    raise SystemExit(1)
account = pwd.getpwnam("fieldwork-agent")
helper = root / "fieldwork-policy-helper"
neutral = subprocess.run(
    [str(helper)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10, check=False,
)
strict = subprocess.run(
    ["/usr/bin/sudo", "-H", "-u", "fieldwork-agent", "/usr/bin/env", "-i",
     f"HOME={account.pw_dir}", "PATH=/usr/local/bin:/usr/bin:/bin", str(helper)],
    stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10, check=False,
)
try:
    neutral_value = json.loads(neutral.stdout)
    strict_value = json.loads(strict.stdout)
except json.JSONDecodeError:
    print("policyHelper returned invalid JSON during UID-scoping probe", file=sys.stderr)
    raise SystemExit(1)
if neutral.returncode or neutral_value != {"managedSettings": {}}:
    print("policyHelper affects a non-agent UID", file=sys.stderr)
    raise SystemExit(1)
if strict.returncode or strict_value.get("managedSettings") != policy or not strict_value.get("claudeMd"):
    print("policyHelper did not return the strict policy for fieldwork-agent", file=sys.stderr)
    raise SystemExit(1)
if sys.platform == "darwin":
    project = Path("/Users/Shared/Fieldwork/projects") / slug
else:
    project = Path("/srv/fieldwork/projects") / slug
if not project.is_dir():
    print(f"probe project is missing: {project}", file=sys.stderr)
    raise SystemExit(1)
probe_commands = (
    "printf fieldwork-probe-build",
    "printf fieldwork-probe-upload",
    "printf fieldwork-probe-verify",
    "printf fieldwork-probe-prepare",
    "printf fieldwork-probe-plain",
    "printf fieldwork-probe-network",
    "printf fieldwork-probe-dns",
    "printf fieldwork-probe-public",
    "printf fieldwork-probe-bind",
    "printf fieldwork-probe-bearer",
    "printf fieldwork-probe-docker",
    "printf fieldwork-probe-systemd",
    "printf fieldwork-probe-raw-http",
    "printf fieldwork-probe-oauth-env",
    "printf fieldwork-probe-proc-env",
    "printf fieldwork-probe-composition",
    "printf fieldwork-probe-env-wrapper",
    "printf fieldwork-probe-policy",
)
policy_denial = b"fieldwork-excluded-client-policy: denied unsafe excluded-client command"
policy_selftests = (
    "/usr/local/bin/fieldwork-pr-upload --status "
    "00000000-0000-4000-8000-000000000001 ; echo FIELDWORK_COMPOSITION_ESCAPE",
    "/usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin "
    "/usr/local/bin/fieldwork-pr-upload --status "
    "00000000-0000-4000-8000-000000000001 && echo FIELDWORK_ENV_ESCAPE",
)
for selftest_command in policy_selftests:
    selftest_event = json.dumps(
        {"tool_name": "Bash", "tool_input": {"command": selftest_command}},
        separators=(",", ":"),
    ).encode()
    selftest = subprocess.run(
        ["/usr/local/bin/fieldwork-bash-policy"], input=selftest_event,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10, check=False,
        env={"PATH": "/usr/local/bin:/usr/bin:/bin"},
    )
    if selftest.returncode != 2 or policy_denial not in selftest.stderr:
        print("managed Bash policy failed an excluded-client composition self-test", file=sys.stderr)
        raise SystemExit(1)

claude_env = [
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1",
    "CLAUDE_CODE_SKIP_PROMPT_HISTORY=1",
    "FIELDWORK_SESSION_PROBE=1",
]
if oauth_token is not None:
    claude_env.append(f"CLAUDE_CODE_OAUTH_TOKEN={oauth_token}")
command_base = [
    "/usr/bin/sudo", "-H", "-u", "fieldwork-agent", "/usr/bin/env", "-i",
    f"HOME={account.pw_dir}", "PATH=/usr/local/bin:/usr/bin:/bin", "LANG=C.UTF-8", "LC_ALL=C.UTF-8",
    f"CLAUDE_CONFIG_DIR={account.pw_dir}/.claude", "CLAUDE_CODE_DISABLE_AUTO_MEMORY=1", *claude_env,
    str(claude), "--setting-sources", "", "--strict-mcp-config", "--mcp-config", str(root / "empty-mcp.json"),
    "--tools", "Bash,Edit,Read,Write,Glob,Grep",
    "-p", "--verbose", "--output-format", "stream-json",
    "--max-turns", "2",
]

def run_claude(probe_command: str) -> subprocess.CompletedProcess[bytes]:
    prompt_text = (
        "Run one authorized deterministic Fieldwork installation diagnostic. "
        "Make exactly one Bash tool call, with its command input set to this exact literal string:\n"
        f"{probe_command}\n"
        "Do not call any other tool. Stop after that tool result."
    )
    return subprocess.run(
        [*command_base, prompt_text], cwd=project, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, timeout=120,
    )

attempts = []
command_results = {}
attempt_errors = {}
for probe_command in probe_commands:
    try:
        attempt = run_claude(probe_command)
    except subprocess.TimeoutExpired:
        print(f"hostile probe timed out at {probe_command}", file=sys.stderr)
        raise SystemExit(1)
    attempts.append(attempt)
    result, error = analyze_attempt(attempt.stdout, probe_command)
    command_results[probe_command] = result
    if attempt.returncode:
        attempt_errors[probe_command] = f"claude-exit-{attempt.returncode}"
    elif error:
        attempt_errors[probe_command] = error

combined_stdout = b"\n".join(attempt.stdout for attempt in attempts)
combined_stderr = b"\n".join(attempt.stderr for attempt in attempts)
_, combined_items = parse_events(combined_stdout)
uses = [
    item for item in combined_items
    if item.get("type") == "tool_use" and item.get("name") == "Bash"
]
missing = [value for value in probe_commands if not command_results.get(value)]

build = command_results.get("printf fieldwork-probe-build", "")
upload = command_results.get("printf fieldwork-probe-upload", "")
verify = command_results.get("printf fieldwork-probe-verify", "")
prepare = command_results.get("printf fieldwork-probe-prepare", "")
plain = command_results.get("printf fieldwork-probe-plain", "")
combined = "\n".join(command_results.values())
client_checks = {
    "build": "fieldwork-pr-build" in build,
    "upload": "unknown_request" in upload,
    "verify": "[fieldwork-verify] OK" in verify,
    "prepare": "fieldwork-pr-prepare" in prepare,
    "plain": "fieldwork-probe-plain" in plain,
    "composition": policy_denial.decode() in command_results.get(
        "printf fieldwork-probe-composition", ""
    ),
    "env-wrapper": policy_denial.decode() in command_results.get(
        "printf fieldwork-probe-env-wrapper", ""
    ),
    "policy": policy_denial.decode() in command_results.get(
        "printf fieldwork-probe-policy", ""
    ),
}
if attempt_errors or missing or not all(client_checks.values()):
    error_summary = ", ".join(
        f"{command.removeprefix('printf fieldwork-probe-')}:{error}"
        for command, error in attempt_errors.items()
    )
    print("an excluded client or ordinary sandbox command did not execute as expected", file=sys.stderr)
    print(
        "hostile probe diagnostics: "
        f"attempt_rcs={[attempt.returncode for attempt in attempts]} "
        f"bash_calls={len(uses)} "
        f"errors={{{error_summary}}} "
        f"missing={[value.removeprefix('printf fieldwork-probe-') for value in missing]} "
        f"checks={client_checks}",
        file=sys.stderr,
    )
    stderr_text = combined_stderr.decode("utf-8", "replace")[:2000]
    if oauth_token is not None:
        stderr_text = stderr_text.replace(oauth_token, "[REDACTED]")
    print(stderr_text, file=sys.stderr)
    raise SystemExit(1)
for sentinel in (
    "FIELDWORK_NETWORK_ESCAPE", "FIELDWORK_DNS_ESCAPE", "FIELDWORK_PUBLIC_ESCAPE",
    "FIELDWORK_BIND_ESCAPE", "FIELDWORK_BEARER_ESCAPE", "FIELDWORK_DOCKER_ESCAPE",
    "FIELDWORK_SYSTEMD_ESCAPE", "FIELDWORK_COMPOSITION_ESCAPE", "FIELDWORK_ENV_ESCAPE",
    "FIELDWORK_RAW_HTTP_ESCAPE",
    "FIELDWORK_OAUTH_ENV_ESCAPE", "FIELDWORK_PROC_ENV_ESCAPE",
):
    if any(line.strip() == sentinel for line in combined.splitlines()):
        print(f"hostile probe detected boundary escape: {sentinel}", file=sys.stderr)
        raise SystemExit(1)
target = root / "claude.probe.sha256"
temp = root / f".claude.probe.sha256.{os.getpid()}"
fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644)
with os.fdopen(fd, "w", encoding="ascii") as handle:
    handle.write(actual + "\n")
    handle.flush()
    os.fsync(handle.fileno())
os.replace(temp, target)
directory = os.open(root, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
try:
    os.fsync(directory)
finally:
    os.close(directory)
print(f"Recorded passing local hostile probe for Claude digest {actual}")
