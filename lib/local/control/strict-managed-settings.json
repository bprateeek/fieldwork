{
  "allowManagedHooksOnly": true,
  "allowManagedMcpServersOnly": true,
  "allowManagedPermissionRulesOnly": true,
  "allowedMcpServers": [],
  "autoMemoryEnabled": false,
  "claudeMd": "# Fieldwork hard-boundary delivery\n\nWork only in the current repository. Commit all intended changes before delivery. Run `/usr/local/bin/fieldwork-pr-build .fieldwork/local/pr-build-request.json` as an exact top-level tool call and note the request ID it prints. Then run `/usr/local/bin/fieldwork-pr-upload <request-id>` as a separate top-level tool call. Never combine those commands in one shell expression and never push directly. The broker rebuilds and scans the Git pack and may queue it for human approval.",
  "claudeMdExcludes": [
    "**/CLAUDE.md",
    "**/CLAUDE.local.md"
  ],
  "disableArtifact": true,
  "disableBypassPermissionsMode": "disable",
  "disableBundledSkills": true,
  "disableClaudeAiConnectors": true,
  "disableSideloadFlags": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/fieldwork-bash-policy",
            "timeout": 5,
            "statusMessage": "Validating Fieldwork boundary command"
          }
        ]
      }
    ]
  },
  "strictKnownMarketplaces": [],
  "strictPluginOnlyCustomization": true,
  "permissions": {
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(docker *)",
      "Bash(podman *)",
      "Bash(colima *)",
      "Bash(orbstack *)",
      "Bash(nerdctl *)",
      "Bash(systemctl --user *)",
      "Bash(systemd-run *)",
      "Read(~/.claude.json)",
      "Read(~/.claude/**)",
      "Read(~/.fieldwork/http-auth)",
      "Read(~/.ssh/**)",
      "Read(~/.docker/**)",
      "Read(~/.colima/**)",
      "Read(~/.orbstack/**)",
      "Read(~/.config/containers/**)",
      "Read(//var/run/docker.sock)",
      "Read(//run/user/*/bus)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "/usr/local/bin/fieldwork-pr-build *",
      "/usr/local/bin/fieldwork-pr-upload *",
      "/usr/local/bin/fieldwork-pr-prepare *",
      "/usr/local/bin/fieldwork-verify *"
    ],
    "filesystem": {
      "allowManagedReadPathsOnly": true,
      "allowRead": ["."],
      "allowWrite": [
        ".",
        "/private/var/run/fieldwork/*/spool",
        "/run/user/*/fieldwork/spool"
      ],
      "denyRead": [
        "~/.claude",
        "~/.claude.json",
        "~/.fieldwork/http-auth",
        "~/.ssh",
        "~/.docker",
        "~/.colima",
        "~/.orbstack",
        "~/.config/containers",
        "/var/run/docker.sock",
        "/run/user/*/bus"
      ],
      "denyWrite": [
        "~/.claude",
        "~/.claude.json",
        "~/.fieldwork/http-auth",
        "~/.ssh",
        "~/.docker",
        "~/.colima",
        "~/.orbstack",
        "~/.config/containers",
        "/var/run/docker.sock",
        "/run/user/*/bus"
      ]
    },
    "network": {
      "allowedDomains": [],
      "allowManagedDomainsOnly": true,
      "allowAllUnixSockets": false,
      "allowLocalBinding": false
    }
  }
}
