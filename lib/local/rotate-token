#!/usr/bin/env bash
set -euo pipefail
[ -t 0 ] && [ -t 1 ] || { echo "token rotation requires an interactive TTY" >&2; exit 1; }
printf 'Forge token: ' >&2
stty -echo
IFS= read -r token </dev/tty
stty echo
printf '\n' >&2
[ -n "$token" ] || { echo "empty token refused" >&2; exit 1; }
case "$token" in github_pat_*|ghp_*) ;; *) echo "token does not look like a GitHub PAT" >&2; exit 1 ;; esac
FIELDWORK_ROTATE_PAT_SOURCE_ONLY=1 source /usr/local/lib/fieldwork-pr-broker/rotate-pat
set +e
fieldwork_validate_pat "$token"
validation_status=$?
set -e
[ "$validation_status" -eq 0 ] || {
  echo "token validation did not succeed; existing token remains unchanged" >&2
  exit 1
}
tmp="/data/token/.forge-token.$$"
umask 077
printf '%s\n' "$token" >"$tmp"
chown 10001:10001 "$tmp"
chmod 0600 "$tmp"
mv "$tmp" /data/token/forge-token
echo "token stored; restart the broker if a request is currently in flight"
