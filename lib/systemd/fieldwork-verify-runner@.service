[Unit]
Description=Fieldwork verify runner (system connection %i)
Requires=fieldwork-verify-runner.socket

[Service]
User=fieldwork
Group=fieldwork
ExecStart=/usr/local/lib/fieldwork/fieldwork-verify-runner
Environment=HOME=/var/empty
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=FIELDWORK_PROJECTS_ROOT=/home/fieldwork/projects
Environment=FIELDWORK_WORKTREES_ROOT=/home/fieldwork/worktrees
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutStartSec=600
Type=simple
# Deliberately no NoNewPrivileges: bwrap/userns verification is the controlled
# escape this root-installed runner exists to provide.
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/fieldwork/projects /home/fieldwork/worktrees
ReadWritePaths=/home/fieldwork/projects /home/fieldwork/worktrees /var/lib/fieldwork-verify
PrivateDevices=true
# bwrap needs AF_NETLINK to bring up loopback inside its new network
# namespace, and it must mount a fresh /proc for its new PID namespace.
# ProtectKernelTunables=true blocks that proc mount before the inner sandbox
# exists. The runner is an unprivileged user with an empty capability set;
# bwrap's read-only root and isolated namespaces are the tunable boundary.
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
UMask=0077
