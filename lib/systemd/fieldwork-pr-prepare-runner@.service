[Unit]
Description=Fieldwork PR prepare runner (system connection %i)
Requires=fieldwork-pr-prepare-runner.socket

[Service]
User=fieldwork
Group=fieldwork
ExecStart=/usr/local/lib/fieldwork/fieldwork-pr-prepare-runner
Environment=HOME=/var/empty
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=FIELDWORK_PROJECTS_ROOT=/home/fieldwork/projects
Environment=FIELDWORK_PR_PREPARE_STATE_DIR=/var/lib/fieldwork-pr-prepare
Environment=GIT_CONFIG_GLOBAL=/dev/null
Environment=GIT_CONFIG_SYSTEM=/dev/null
Environment=GIT_CONFIG_NOSYSTEM=1
Environment=GIT_AUTHOR_NAME=Fieldwork Agent
Environment=GIT_AUTHOR_EMAIL=fieldwork-agent@localhost
Environment=GIT_COMMITTER_NAME=Fieldwork Agent
Environment=GIT_COMMITTER_EMAIL=fieldwork-agent@localhost
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutStartSec=30
Type=simple
# Deliberately no NoNewPrivileges: this trusted runner is the controlled escape
# from the agent session's NNP/user-namespace cage.
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/fieldwork/projects
ReadWritePaths=/home/fieldwork/projects /var/lib/fieldwork-pr-prepare
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
UMask=0077
