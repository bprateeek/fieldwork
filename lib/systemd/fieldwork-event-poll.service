[Unit]
Description=Fieldwork root-installed event poller

[Service]
Type=oneshot
User=fieldwork
Group=fieldwork
ExecStart=/usr/local/lib/fieldwork/fieldwork-event-poll
Environment=HOME=/home/fieldwork
Environment=FIELDWORK_PROJECTS_ROOT=/home/fieldwork/projects
Environment=FIELDWORK_WORKTREES_ROOT=/home/fieldwork/worktrees
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/fieldwork/projects /home/fieldwork/worktrees /home/fieldwork/.fieldwork
