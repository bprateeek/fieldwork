[Unit]
Description=Fieldwork hard-boundary agent session for %i
After=network-online.target

[Service]
User=fieldwork
Group=fieldwork
WorkingDirectory=/home/fieldwork/projects/%i
ExecStart=/usr/local/lib/fieldwork/fieldwork-agent-session %i
Environment=HOME=/home/fieldwork
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/fieldwork/projects/%i /home/fieldwork/.fieldwork /home/fieldwork/.claude /home/fieldwork/.cache
# Claude's bwrap sandbox uses NETLINK_ROUTE to bring up loopback in its
# isolated network namespace. Without AF_NETLINK every Bash tool fails before
# the requested command starts.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
