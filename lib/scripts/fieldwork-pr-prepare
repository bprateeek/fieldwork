#!/usr/bin/python3 -I
"""Root-installed, subprocess-free client for the system PR-prepare runner."""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import socket
import stat
import sys


SOCKET_PATH = "/run/fieldwork/fieldwork-pr-prepare.sock"
UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$")
MAX_REQUEST_BYTES = 32 * 1024
REQUIRED_FIELDS = {"request_id", "created_at", "repo_path", "branch", "paths", "message"}


def fail(message: str, code: int = 20) -> "None":
    print(f"[fieldwork-pr-prepare] {message}", file=sys.stderr)
    raise SystemExit(code)


def spool_request(request_id: str) -> bytes:
    uid = os.getuid()
    if sys.platform == "darwin":
        path = Path("/private/var/run/fieldwork", str(uid), "spool", request_id)
    else:
        path = Path("/run/fieldwork-agent/spool", request_id)
    fd = os.open("/", os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        for component in path.parts[1:]:
            next_fd = os.open(component, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0), dir_fd=fd)
            info = os.fstat(next_fd)
            if not stat.S_ISDIR(info.st_mode) or info.st_uid not in (0, uid):
                os.close(next_fd)
                fail("unsafe spool directory")
            if info.st_uid == uid and stat.S_IMODE(info.st_mode) & 0o077:
                os.close(next_fd)
                fail("unsafe spool directory permissions")
            os.close(fd)
            fd = next_fd
        if set(os.listdir(fd)) != {"request.json"}:
            fail("prepare spool directory must contain exactly request.json")
        request_fd = os.open("request.json", os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0), dir_fd=fd)
        info = os.fstat(request_fd)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != uid
            or stat.S_IMODE(info.st_mode) & 0o077
            or info.st_size <= 0
            or info.st_size > MAX_REQUEST_BYTES
        ):
            os.close(request_fd)
            fail("unsafe or oversized prepare request")
        raw = b""
        while len(raw) < info.st_size:
            chunk = os.read(request_fd, info.st_size - len(raw))
            if not chunk:
                break
            raw += chunk
        os.close(request_fd)
    finally:
        os.close(fd)
    try:
        value = json.loads(raw)
    except (UnicodeError, json.JSONDecodeError):
        fail("request.json is invalid UTF-8 JSON")
    if not isinstance(value, dict) or not REQUIRED_FIELDS.issubset(value) or value.get("request_id") != request_id:
        fail("request.json is missing required fields or has a mismatched request_id")
    return (json.dumps(value, separators=(",", ":")) + "\n").encode("utf-8")


def relay(sock: socket.socket) -> int:
    exit_code: int | None = None
    buffer = b""
    while True:
        chunk = sock.recv(8192)
        if not chunk:
            break
        buffer += chunk
        while b"\n" in buffer:
            line, buffer = buffer.split(b"\n", 1)
            tag, separator, payload = line.partition(b"\t")
            if not separator:
                fail("runner returned a malformed frame")
            if tag == b"O":
                sys.stdout.buffer.write(payload + b"\n")
            elif tag == b"E":
                sys.stderr.buffer.write(payload + b"\n")
            elif tag == b"X":
                try:
                    exit_code = int(payload)
                except ValueError:
                    fail("runner returned an invalid exit frame")
            else:
                fail("runner returned an unknown frame")
    if exit_code is None:
        fail("runner closed without an exit frame")
    return exit_code


def main(argv: list[str]) -> int:
    if len(argv) != 2 or not UUID_RE.fullmatch(argv[1].lower()):
        fail("usage: fieldwork-pr-prepare <request_id>")
    request_id = argv[1].lower()
    raw = spool_request(request_id)
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(35)
        sock.connect(SOCKET_PATH)
        with sock:
            sock.sendall(raw)
            sock.shutdown(socket.SHUT_WR)
            return relay(sock)
    except OSError as exc:
        fail(f"runner socket failed: {exc}")


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
