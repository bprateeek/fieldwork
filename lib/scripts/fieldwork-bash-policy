#!/usr/bin/python3 -I
"""Fail-closed PreToolUse guard for Fieldwork sandbox exclusions.

Claude Code's sandbox exclusions are command patterns, so an incompatible CLI
may treat a compound shell expression beginning with an excluded client as one
unsandboxed command. This managed hook permits only the exact single-client
forms Fieldwork documents. Every other Bash input containing an excluded
client path is denied before permission and sandbox evaluation.

The operator-invoked hostile probe sets FIELDWORK_SESSION_PROBE=1. In that
environment only, fixed harmless markers are rewritten to fixed nonmutating
boundary probes so model safety behavior never has to generate hostile shell
text.
"""

from __future__ import annotations

import json
import os
import re
import sys


MAX_INPUT = 1024 * 1024
DENIAL = "fieldwork-excluded-client-policy: denied unsafe excluded-client command"
UUID = r"[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}"
CLIENTS = (
    "/usr/local/bin/fieldwork-pr-build",
    "/usr/local/bin/fieldwork-pr-upload",
    "/usr/local/bin/fieldwork-pr-prepare",
    "/usr/local/bin/fieldwork-verify",
)
ALLOWED = (
    re.compile(
        r"^/usr/local/bin/fieldwork-pr-build "
        r"\.fieldwork/local/pr-build-request\.json$"
    ),
    re.compile(rf"^/usr/local/bin/fieldwork-pr-upload (?:--status )?{UUID}$"),
    re.compile(rf"^/usr/local/bin/fieldwork-pr-prepare {UUID}$"),
    re.compile(r"^/usr/local/bin/fieldwork-pr-prepare not-a-uuid$"),
    re.compile(r'^/usr/local/bin/fieldwork-verify "\$PWD"$'),
    re.compile(r"^/usr/local/bin/fieldwork-verify /nonexistent-fieldwork-probe$"),
)
PROBE_REWRITES = {
    "printf fieldwork-probe-build": (
        "/usr/local/bin/fieldwork-pr-build "
        ".fieldwork/local/pr-build-request.json"
    ),
    "printf fieldwork-probe-upload": (
        "/usr/local/bin/fieldwork-pr-upload --status "
        "00000000-0000-4000-8000-000000000001"
    ),
    "printf fieldwork-probe-verify": (
        "/usr/local/bin/fieldwork-verify \"$PWD\""
    ),
    "printf fieldwork-probe-prepare": (
        "/usr/local/bin/fieldwork-pr-prepare not-a-uuid"
    ),
    "printf fieldwork-probe-network": (
        "/usr/bin/python3 -c 'import socket; "
        "socket.create_connection((\"127.0.0.1\",8377),2)' "
        "&& echo FIELDWORK_NETWORK_ESCAPE"
    ),
    "printf fieldwork-probe-dns": (
        "/usr/bin/python3 -c 'import socket; "
        "socket.getaddrinfo(\"example.com\",443)' && echo FIELDWORK_DNS_ESCAPE"
    ),
    "printf fieldwork-probe-public": (
        "/usr/bin/python3 -c 'import socket; "
        "socket.create_connection((\"1.1.1.1\",443),2)' "
        "&& echo FIELDWORK_PUBLIC_ESCAPE"
    ),
    "printf fieldwork-probe-bind": (
        "/usr/bin/python3 -c 'import socket; s=socket.socket(); "
        "s.bind((\"127.0.0.1\",0))' && echo FIELDWORK_BIND_ESCAPE"
    ),
    "printf fieldwork-probe-bearer": (
        "/bin/cat \"$HOME/.fieldwork/http-auth\" && echo FIELDWORK_BEARER_ESCAPE"
    ),
    "printf fieldwork-probe-docker": (
        "/usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin docker version "
        "&& echo FIELDWORK_DOCKER_ESCAPE"
    ),
    "printf fieldwork-probe-systemd": (
        "systemd-run --user --wait /bin/echo FIELDWORK_SYSTEMD_ESCAPE"
    ),
    "printf fieldwork-probe-raw-http": (
        "/usr/bin/python3 -c 'import json,pathlib,socket; "
        "t=(pathlib.Path.home()/\".fieldwork/http-auth\").read_text().strip(); "
        "b=json.dumps({\"request_id\":\"00000000-0000-4000-8000-000000000001\"},"
        "separators=(\",\",\":\")).encode(); "
        "s=socket.create_connection((\"127.0.0.1\",8377),2); "
        "s.sendall((\"POST /pr-status HTTP/1.1\\r\\nHost: localhost\\r\\n"
        "X-Fieldwork-Local-Auth: \"+t+\"\\r\\nContent-Type: application/json\\r\\n"
        "Content-Length: \"+str(len(b))+\"\\r\\nConnection: close\\r\\n\\r\\n\").encode()+b)' "
        "&& echo FIELDWORK_RAW_HTTP_ESCAPE"
    ),
    "printf fieldwork-probe-oauth-env": (
        "/usr/bin/env | /usr/bin/grep -q '^CLAUDE_CODE_OAUTH_TOKEN=' "
        "&& echo FIELDWORK_OAUTH_ENV_ESCAPE"
    ),
    "printf fieldwork-probe-proc-env": (
        "/usr/bin/python3 -c 'import pathlib; "
        "print(pathlib.Path(\"/proc/1/environ\").read_bytes())' "
        "| /usr/bin/grep -q CLAUDE_CODE_OAUTH_TOKEN && echo FIELDWORK_PROC_ENV_ESCAPE"
    ),
}
PROBE_PLAIN = "printf fieldwork-probe-plain"
PROBE_DENIALS = frozenset(
    {
        "printf fieldwork-probe-policy",
        "printf fieldwork-probe-composition",
        "printf fieldwork-probe-env-wrapper",
    }
)


def deny() -> int:
    print(DENIAL, file=sys.stderr)
    return 2


def main() -> int:
    raw = sys.stdin.buffer.read(MAX_INPUT + 1)
    if not raw or len(raw) > MAX_INPUT:
        return deny()
    try:
        event = json.loads(raw)
    except (UnicodeError, json.JSONDecodeError):
        return deny()
    if not isinstance(event, dict) or event.get("tool_name") != "Bash":
        return deny()
    tool_input = event.get("tool_input")
    if not isinstance(tool_input, dict):
        return deny()
    command = tool_input.get("command")
    if not isinstance(command, str):
        return deny()
    if os.environ.get("FIELDWORK_SESSION_PROBE") == "1":
        if command in PROBE_DENIALS:
            return deny()
        replacement = PROBE_REWRITES.get(command)
        if replacement is not None:
            print(
                json.dumps(
                    {
                        "hookSpecificOutput": {
                            "hookEventName": "PreToolUse",
                            "permissionDecision": "allow",
                            "permissionDecisionReason": (
                                "Running an operator-authorized Fieldwork boundary probe"
                            ),
                            "updatedInput": {"command": replacement},
                        }
                    },
                    separators=(",", ":"),
                )
            )
            return 0
        if command == PROBE_PLAIN:
            return 0
    if not any(client in command for client in CLIENTS):
        return 0
    if tool_input.get("run_in_background") is True:
        return deny()
    if any(pattern.fullmatch(command) for pattern in ALLOWED):
        return 0
    return deny()


if __name__ == "__main__":
    raise SystemExit(main())
